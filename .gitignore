# ===============================
# Python / Backend
# ===============================

# Virtual environment
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables
.env
.env.*  

# SQLite DB (if you use temporarily)
*.db
*.sqlite3

# Logs
*.log

# Pickle files (if you use for caching or temporary storage)
*.pkl

# Migrations (optional, if using Alembic)
alembic/versions/*.pyc
alembic/versions/*.py

# gdrive credentials
credentials.json
client_secret.json
token.pickle
sift_database.pkl

